*.yml text eol=lf
*.yaml text eol=lf
*.j2 text eol=lf
*.json text eol=lf
*.md text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.template text eol=lf
Caddyfile text eol=lf
Dockerfile text eol=lf
subscribe/pa text eol=lf
